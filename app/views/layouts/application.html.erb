  </head>
  <body>
    <div class="main-wrapper profile">
      <header class="header">
        <nav>
          <h1><%= link_to_unless_current "About", root_path %> |
          <%= link_to_unless_current "Talks", talks_path %> |
          <%= link_to_unless_current "Contact", contact_path %> |
          <%= link_to_unless_current "Blog", blog_path, target: "_blank" %> |
          <div class="resume-dropdown">
            <button type="button" class="resume-dropdown-toggle" aria-haspopup="true" aria-expanded="false">Resume</button>
            <div class="resume-dropdown-menu">
              <div class="resume-dropdown-menu-inner">
                <%= link_to "Engineering Resume (PDF)", resume_path(variant: "engineering"), target: "_blank", class: "resume-dropdown-item" %>
                <%= link_to "Educator / Writer Resume (PDF)", resume_path(variant: "educator"), target: "_blank", class: "resume-dropdown-item" %>
              </div>
            </div>
          </div></h1>
        </nav>
      </header>
      <div class="profile-banner" id="yechiel-k-cover"></div>
      <div class="vitals-container">
        <div class="profile-photo" id="yechiel-k-card"></div>
        <div class="social-icon-container">
          <a href="<%= SocialLinks.github %>" target="_blank"><%= image_tag "github.png", class: "social-icon" %></a>
          <a href="<%= SocialLinks.linkedin %>" target="_blank"><%= image_tag "linkedin.png", class: "social-icon" %></a>
          <a href="<%= blog_path %>" target="_blank"><%= image_tag "medium.png", class: "social-icon" %></a>
          <a href="<%= SocialLinks.devto %>" target="_blank"><%= image_tag "https://d2fltix0v2e0sb.cloudfront.net/dev-badge.svg", class: "social-icon" %></a>
        </div>
        <div class="vitals-text-container">
          <h1 class="profile-name">Yechiel Kalmenson</h1>
          <% if current_title.present? %>
            <h2 class="profile-location">
              <%= [current_title, current_employer].compact.join(' at ') %>
            </h2>
          <% end %>
          <h2 class="profile-location">Blogger at <%= link_to "Rabbi On Rails", blog_path %></h2>
          <h2 class="profile-location">Editor and curator at <%= link_to "Torah && Tech", SocialLinks.torah_tech %></h2>
          <% if action_name == "index" %>
            <div class="profile-quote">
              “In life, there's no such thing as staying where you are. If you are not actively growing you are inevitably falling behind."<br>
                -The Lubavitcher Rebbe
            </div>
          <% end %>
        </div>
      </div>

      <%= yield %>

    </div>
    <footer class="footer">
      &copy; <%= Time.now.year %> <%= link_to "Yechiel Kalmenson", root_path %>
    </footer>
  </body>
  <% flash.each do |type, msg| %>
    <script>
      alert("\"<%= msg %>\"")
    </script>
  <% end %>
</html>
